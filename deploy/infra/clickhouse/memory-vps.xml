<!--
  Hồ sơ RAM cho VPS 6 GiB / 4 core (thay memory.xml của dev).

  VÌ SAO PHẢI GHIM SỐ TUYỆT ĐỐI, không dùng tỷ lệ như dev:
  `max_server_memory_usage_to_ram_ratio` tính theo RAM mà container NHÌN THẤY. Trên
  máy dev nó thấy 31 GiB nên tự cấp 18,74 GiB trần và mark cache 5 GiB — đo 2026-08-27.
  Trên VPS 6 GiB, tỷ lệ 0.6 cho ra 3,6 GiB, vẫn quá nhiều: cả Postgres, Redis,
  ingester, API và pipeline tin phải chia nhau 6 GiB đó. Ghim số tuyệt đối là cách
  duy nhất nói được "ClickHouse chỉ được lấy chừng này".

  ĐO TRỌN MỘT PHIÊN 2026-08-27 (2.021 mã, 4,27 triệu dòng ghi):
    MemoryTracking  trung bình 373 MB  ·  ĐỈNH 1,18 GiB
    MemoryResident  ĐỈNH 1,80 GiB
  🔴 Bản đầu của file này đặt trần mềm 1,5 GiB dựa trên số 427 MB đo lúc 09:00 —
  đó là giá trị ĐẦU PHIÊN, không phải đỉnh. Tải thật chạm 79% trần đó.

  Lưu ý khi đọc con số đỉnh: nó đo trên dev, nơi ClickHouse được phép giữ mark cache
  5 GiB và trần 18,74 GiB — nó DÙNG những gì được cấp. Dưới hồ sơ này (cache 256 MiB)
  đỉnh sẽ thấp hơn, nhưng THẤP BAO NHIÊU thì CHƯA ĐO. Vì vậy trần đặt rộng hơn đỉnh
  quan sát được, và phải chạy một phiên dưới trần cứng rồi mới được nói "đủ".
-->
<clickhouse>
  <!-- Trần cứng. Vượt là ClickHouse ném MEMORY_LIMIT_EXCEEDED chứ không để OOM
       killer của kernel giết cả tiến trình — hỏng có kiểm soát, dễ chẩn đoán. -->
  <max_server_memory_usage>2147483648</max_server_memory_usage>   <!-- 2,0 GiB — trên đỉnh đo được 1,18 GiB -->

  <!-- Cache mark: mặc định 5 GiB, gần bằng cả máy. Kho `rt` hiện vài MB nên
       256 MiB thừa sức; đây là cache, thiếu thì chậm chứ không sai. -->
  <mark_cache_size>268435456</mark_cache_size>                    <!-- 256 MiB -->
  <uncompressed_cache_size>134217728</uncompressed_cache_size>    <!-- 128 MiB -->

  <!-- 4 core, mà ingester + Postgres + API cũng cần CPU. Mặc định 16 luồng nền
       (đo dev: 816 thread) là quá tải rõ trên máy này. -->
  <background_pool_size>4</background_pool_size>
  <background_schedule_pool_size>4</background_schedule_pool_size>
  <background_merges_mutations_concurrency_ratio>2</background_merges_mutations_concurrency_ratio>

  <!-- 🔴 Bắt buộc đi kèm hai dòng trên — thiếu là ClickHouse KHÔNG khởi động được.
       sanityCheck() của MergeTreeSettings đòi MỌI setting number_of_free_entries_in_pool_to_*
       (mặc định trong <merge_tree> của config.xml) phải ≤ background_pool_size × ratio = 4×2 = 8,
       nếu không server ném BAD_ARGUMENTS (Code 36) và thoát ngay ~1s sau start. Đo thật
       2026-08-27 chạy container dưới đúng hồ sơ này (xem ledger plan spill-to-disk) — bắt
       lần lượt TỪNG setting một (mutation trước, rồi optimize_entire_partition) vì
       sanityCheck() dừng ở lỗi đầu tiên; hạ cả ba mặc định liên quan trong MỘT lượt
       để không phải dò tiếp lần ba. -->
  <merge_tree>
    <number_of_free_entries_in_pool_to_execute_mutation>4</number_of_free_entries_in_pool_to_execute_mutation>
    <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>4</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
    <number_of_free_entries_in_pool_to_lower_max_size_of_merge>4</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
  </merge_tree>

  <!-- Trần mỗi truy vấn: một câu hỏi lỡ tay của API không được kéo sập server. -->
  <max_concurrent_queries>32</max_concurrent_queries>
  <profiles>
    <default>
      <max_memory_usage>536870912</max_memory_usage>              <!-- 512 MiB/truy vấn -->
      <max_threads>2</max_threads>
    </default>
  </profiles>
</clickhouse>
