# Postgres
POSTGRES_DB=dulieu
POSTGRES_USER=dulieu
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ClickHouse (kho realtime — bật bằng cách bỏ comment dòng COMPOSE_PROFILES)
# COMPOSE_PROFILES=realtime
CLICKHOUSE_PASSWORD=change-me-in-production
CLICKHOUSE_URL=http://default:change-me-in-production@127.0.0.1:8123
CLICKHOUSE_BACKUP_DIR=./clickhouse-backups
# tương đối => giải theo deploy/infra (cùng gốc compose); nên đặt tuyệt đối khi deploy

# Database URLs (postgres-data — schema/migrations + test)
DATA_DATABASE_URL=postgresql+psycopg://dulieu:change-me-in-production@127.0.0.1:5432/dulieu
TEST_DATABASE_URL=postgresql+psycopg://dulieu:change-me-in-production@127.0.0.1:5432/dulieu_test

# App
APP_ENV=dev
LOG_LEVEL=info

# Lat cat ingester + OMO (spec 2026-08-26)
# User ung dung tao per-moi-truong, ngoai migration (xem database/README.md)
CLICKHOUSE_INGESTER_URL=http://ingester_worker:change-me-in-production@127.0.0.1:8123
REDIS_URL=redis://127.0.0.1:6379/0
ETL_DATABASE_URL=postgresql+psycopg://etl_worker:change-me-in-production@127.0.0.1:5432/dulieu
# Thu muc runtime NGOAI repo (log + file frame che do do); bo trong = <repo>/../dlck-runtime
# INGESTER_LOG_DIR=D:\dlck-runtime\logs
# INGESTER_MEASURE_DIR=D:\dlck-runtime\measure
# INGESTER_SPILL_DIR=D:\dlck-runtime\spill
